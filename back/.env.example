# Copiá este archivo como .env y completá los valores. El .env nunca se sube al repositorio.

# Base PostgreSQL de DESARROLLO (Neon rb-rojas-bakery-dev). Se obtiene con:
#   vercel env pull .env.dev --environment=development   (y copiás estas dos líneas)
DATABASE_URL="postgresql://usuario:clave@host-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host/neondb?sslmode=require"

# Clave para firmar las sesiones. En producción es obligatoria: generá una larga y al azar, por ejemplo con
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiar-por-una-clave-larga-y-secreta"

PORT=3001

# Fotos: en tu PC van a la carpeta back/uploads (o FOTOS_DIR). Si definís BLOB_READ_WRITE_TOKEN,
# se usa Vercel Blob (así funciona en producción). FOTOS_ALMACEN=disco|blob fuerza uno.
# FOTOS_DIR="/ruta/persistente/uploads"
# BLOB_READ_WRITE_TOKEN="

# Usuaria inicial que crea el seed (npm run db:seed). Usá una contraseña propia de al menos 8 caracteres.
SEED_EMAIL="usuaria@ejemplo.com"
SEED_NOMBRE="Nombre Apellido"
SEED_PASSWORD="una-contraseña-segura"
